# Copy to .env (scripts/modules/elastic.sh does this for you) and set passwords.
# ELASTIC_VERSION is seeded from config/versions.env.

ELASTIC_VERSION=9.5.1

# Password for the 'elastic' superuser (Elasticsearch + Kibana login).
ELASTIC_PASSWORD=changeme

# Password for the 'kibana_system' service account (set by the module on first boot).
KIBANA_PASSWORD=changeme

# Elasticsearch JVM heap. 2g is comfortable on a 64GB machine; raise for big data sets.
ES_HEAP=2g
