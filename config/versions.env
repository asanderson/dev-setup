# versions.env — pinned versions for repeatable installs.
#
# Tools installed from apt repos (git, docker, jdk, C/C++ toolchain) always
# track the newest package in their repo, so they are not pinned here.
# Tools fetched as artifacts are pinned so a re-run months later produces
# the same machine. Bump these deliberately, then re-run the module.
#
# Set to "latest" where a module supports dynamic resolution.

# Apache Maven (https://maven.apache.org/download.cgi)
# Note: dlcdn.apache.org hosts only the newest release; if this pin has been
# superseded, the module falls back to the Apache archive automatically.
MAVEN_VERSION="3.9.16"

# Go toolchain. "latest" resolves via https://go.dev/VERSION?m=text
GO_VERSION="latest"

# Elastic Stack (Elasticsearch + Kibana images, Basic license)
ELASTIC_VERSION="9.5.1"

# OpenSearch Platform (OpenSearch + Dashboards images — released in lockstep,
# one pin covers both). Latest: https://endoflife.date/api/opensearch.json
OPENSEARCH_VERSION="3.8.0"

# Newest Clang/LLVM major with a final release on apt.llvm.org (23 is still
# rc as of 2026-08; the archive ships 21). Suites: apt.llvm.org/<codename>/dists/
LLVM_VERSION="22"

# k9s fallback pin, used only when resolving the latest GitHub release fails
# at run time. Latest: https://github.com/derailed/k9s/releases
K9S_VERSION="v0.50.18"

# Temurin JDK major version (latest LTS). Used when you pick Temurin over
# Ubuntu's default OpenJDK packages.
JDK_MAJOR="25"

# Proton VPN apt-repo bootstrap package + its sha256 as published on
# https://protonvpn.com/support/official-linux-vpn-ubuntu/ (the repo it
# configures then serves the apps, which track latest via apt). The other
# Proton apps resolve their latest release at run time (see their modules).
PROTON_VPN_RELEASE_DEB="https://repo.protonvpn.com/debian/dists/stable/main/binary-all/protonvpn-stable-release_1.0.8_all.deb"
PROTON_VPN_RELEASE_DEB_SHA256="0b14e71586b22e498eb20926c48c7b434b751149b1f2af9902ef1cfe6b03e180"
